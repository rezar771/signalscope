# Copy to .env and fill in. Never commit .env.

# auto  = OpenRouter first, local Ollama on failure (default)
# cloud = OpenRouter only
# local = Ollama only; no data leaves the machine
LLM_MODE=auto

# Free key from https://openrouter.ai/keys (leave empty to run local-only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local fallback (Ollama OpenAI-compatible endpoint)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Optional tuning
# LLM_TIMEOUT_S=60
# HTTP_TIMEOUT_S=45
# CACHE_TTL_S=3600
# CACHE_PATH=.cache/http
